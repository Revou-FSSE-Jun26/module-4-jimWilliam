# Copy to .env and fill in real values. Never commit .env.
FLASK_APP=wsgi.py

# PostgreSQL connection string (Railway provides this as DATABASE_URL).
# Local example: postgresql://revotask:revotask@localhost:5432/revotask
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Hours until a login token expires.
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# The Next.js origin(s) allowed by CORS, comma-separated.
FRONTEND_ORIGIN=http://localhost:3000
