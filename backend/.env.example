# Copy to .env and fill in real values. Never commit .env.
FLASK_APP=wsgi.py

# PostgreSQL connection string.
# Local:      postgresql://USER:PASSWORD@127.0.0.1:5432/revotask
# Supabase (Project Settings > Database > Connection string):
#   - The API on Vercel uses the TRANSACTION pooler, port 6543:
#       postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#     (the app turns prepared statements off and skips client-side pooling for port 6543)
#   - Migrations (flask db upgrade) use the SESSION pooler or direct connection, port 5432:
#       postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Hours until a login token expires.
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# The Next.js origin(s) allowed by CORS, comma-separated (your frontend Vercel URL in production).
FRONTEND_ORIGIN=http://localhost:3000
