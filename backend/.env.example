# Copy to .env and fill in real values. Never commit .env.
FLASK_APP=wsgi.py

# PostgreSQL connection string.
# Local:      postgresql://USER:PASSWORD@127.0.0.1:5432/revotask
# Supabase (Connect > Session pooler):
#   The API on Render and the migrations both use the SESSION pooler, port 5432 (IPv4):
#       postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   The app keeps a small pool per Gunicorn worker (DB_POOL_SIZE=3, DB_MAX_OVERFLOW=2 by default).
#   The direct connection (db.PROJECT_REF.supabase.co) is IPv6 unless the project has the IPv4 add-on.
#   On a serverless host, the TRANSACTION pooler (port 6543) also works: the app then turns prepared
#   statements off and skips client-side pooling.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Hours until a login token expires.
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# The Next.js origin(s) allowed by CORS, comma-separated (your frontend Vercel URL in production).
FRONTEND_ORIGIN=http://localhost:3000
