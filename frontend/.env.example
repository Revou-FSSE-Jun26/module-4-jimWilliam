# Copy to .env.local and fill in. Never commit .env.local.

# Flask API base URL used by Client Components (exposed to the browser).
# Use 127.0.0.1 rather than localhost on Windows: localhost resolves to IPv6 first and the Flask
# dev server listens on IPv4 only, which adds about a second to every request.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000

# Flask API base URL used by Server Components and Server Actions (server only).
API_BASE_URL=http://127.0.0.1:5000

# Live frontend URL that the Playwright suite runs against (e.g. https://revotask.vercel.app).
PLAYWRIGHT_BASE_URL=http://localhost:3000
